<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:tabIndicatorColor="@color/brand_blue"
        app:tabSelectedTextColor="@color/brand_blue"
        app:tabTextColor="#5F6368"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorHeight="3dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        
        <LinearLayout
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/accuracyLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:text="确保准确:"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/accuracyCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="2dp"
                        android:buttonTint="@color/brand_blue"
                        android:gravity="center_vertical" />

                    <TextView
                        android:id="@+id/repeatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:text="重复模式:"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/repeatCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="2dp"
                        android:buttonTint="@color/brand_blue"
                        android:gravity="center_vertical" />
                </LinearLayout>

                
                <TextView
                    android:id="@+id/releaseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:singleLine="true"
                    android:text="解除占用"
                    android:textColor="#5F6368"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/plan1Button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="方案1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/brand_blue"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/plan2Button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="方案2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#E8EAED"
                    android:textColor="#202124" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/logHScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:scrollbars="horizontal"
                android:fillViewport="true">

                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/logView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:letterSpacing="0"
                        android:lineSpacingExtra="0dp"
                        android:lineSpacingMultiplier="1.0"
                        android:textColor="#1A1A1A"
                        android:textSize="9sp"
                        android:textIsSelectable="true"
                        android:text="" />
                </ScrollView>
            </HorizontalScrollView>

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="开始"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/brand_blue"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="关闭"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#E8EAED"
                    android:textColor="#202124" />
            </LinearLayout>
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/pageFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="密码本"
                    android:textColor="#202124"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                
                <ImageButton
                    android:id="@+id/saveButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="保存密码本到文件"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_save" />

                
                <ImageButton
                    android:id="@+id/deleteButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="删除当前保存的密码"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_delete" />
            </LinearLayout>

            
            <TextView
                android:id="@+id/filePathLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="#5F6368"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <TextView
                android:id="@+id/fileStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FDECEA"
                android:padding="14dp"
                android:textColor="#C5221F"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:padding="10dp">

                <TextView
                    android:id="@+id/fileContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#202124"
                    android:textSize="12sp"
                    android:textIsSelectable="true" />
            </ScrollView>

            <Button
                android:id="@+id/refreshButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="刷新"
                android:backgroundTint="#E8EAED"
                android:textColor="#202124" />
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/pageAbout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            

            
            <ImageView
                android:id="@+id/aboutAvatar"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:contentDescription="作者头像"
                android:scaleType="fitCenter"
                android:src="@drawable/about_avatar" />

            
            <TextView
                android:id="@+id/aboutName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:text="天蓝色的小牛"
                android:textColor="#202124"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="#1A000000" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的个人主页:"
                    android:textColor="#202124"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/aboutLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="github.com/tianlansedexiaoniu"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
